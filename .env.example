# Remote MySQL connection string
# mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://user:password@your-mysql-host:3306/coaching"

# Long random string used to sign login tokens (e.g. `openssl rand -hex 32`)
JWT_SECRET="change-me-to-a-long-random-string"

# Timezone used for "today" in attendance and dashboard
APP_TIMEZONE="Asia/Dhaka"

# First admin account — created by `npm run seed:admin`
DEMO_ADMIN_EMAIL="admin@example.com"
DEMO_ADMIN_USERNAME="admin"
DEMO_ADMIN_PASSWORD="change-me-123"

# Optional: allows POST /api/auth/seed with header x-seed-secret (dev only unless ALLOW_SEED_IN_PRODUCTION=true)
SEED_SECRET=""
ALLOW_SEED_IN_PRODUCTION="false"

# Optional fallback SMS credentials (the values saved in Admin → Settings take priority)
SMS_API_KEY=""
SMS_SENDER_ID=""
